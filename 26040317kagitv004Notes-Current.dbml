Ref "roleClaim>role(Simple): claims belong to a role": identity.asp_net_role_claim.role_id > identity.asp_net_role.id
Ref "userClaim>user(Simple): claims belong directly to a user": identity.asp_net_user_claim.user_id > identity.asp_net_user.id
Ref "userLogin>user(Simple): external logins belong to a user": identity.asp_net_user_login.user_id > identity.asp_net_user.id
Ref "userRole>role(BridgeTable): bridge row points to a role": identity.asp_net_user_role.role_id - identity.asp_net_role.id
Ref "userRole>user(BridgeTable): bridge row points to a user": identity.asp_net_user_role.user_id - identity.asp_net_user.id
Ref "userToken>User(Simple): tokens belong to a user": identity.asp_net_user_token.user_id - identity.asp_net_user.id
Ref "openidAuthorization>openidApplication(Simple): authorizations belong to a registered client": identity.open_iddict_authorization.application_id > identity.open_iddict_application.id
Ref "openidToken>openidApplication(DoubleSimple): token optionally belongs to a registered client": identity.open_iddict_token.application_id > identity.open_iddict_application.id
Ref "openidToken>openidAuthorization(Simple): token optionally belongs to an authorization": identity.open_iddict_token.authorization_id > identity.open_iddict_authorization.id
Ref "deliveryOrderDetail>deliveryOrder(Simple): detail row belongs to a delivery order": ordering.delivery_order_detail.delivery_order_id > ordering.delivery_order.id
Ref "order>buyer(Simple): order optionally belongs to a buyer": ordering.order.buyer_id > ordering.buyer.id
Ref "order>paymentMethod(Simple): order optionally uses a stored payment method": ordering.order.payment_method_id > ordering.payment_method.id
Ref "orderItem>order(Simple): line item belongs to an order": ordering.order_item.order_id > ordering.order.id
Ref "paymentMethod>buyer(Simple): stored payment method belongs to a buyer": ordering.payment_method.buyer_id > ordering.buyer.id
Ref "paymentMethod>cardType(Simple): stored payment method uses a card type": ordering.payment_method.card_type_id > ordering.card_type.id
Ref "salesInvoiceDetail>salesInvoice(Simple): invoice line belongs to a sales invoice": ordering.sales_invoice_detail.sales_invoice_id > ordering.sales_invoice.id
Ref "salesPaymentDetail>salesPayment(Simple): payment detail belongs to a payment header": ordering.sales_payment_detail.sales_payment_id > ordering.sales_payment.id
Ref "exchangeRate>fromCurrency(Simple): source currency for the exchange rate": sales.exchange_rate.from_currency_code > sales.currency.code
Ref "exchangeRate>toCurrency(Simple): target currency for the exchange rate": sales.exchange_rate.to_currency_code > sales.currency.code
Ref "salesItem>baseCurrency(Simple): base currency for catalog pricing": sales.salesitem.base_currency_code > sales.currency.code
Ref "salesItem>brand(Simple): brand classification for the catalog item": sales.salesitem.sales_item_brand_id > sales.salesitem_brand.id
Ref "salesItem>type(Simple): type classification for the catalog item": sales.salesitem.sales_item_type_id > sales.salesitem_type.id
Ref "salesItemDimension>salesItem(Simple): dimensions belong to one catalog item": sales.salesitem_dimension.sales_item_id - sales.salesitem.id
Ref "salesItemDimension>dimensionUnit(Simple): unit used for length, width, and height": sales.salesitem_dimension.dimension_unit_id > sales.unit_measurement.id
Ref "salesItemDimension>quantityUnit(Simple): unit used for quantity packaging": sales.salesitem_dimension.quantity_unit_id > sales.unit_measurement.id
Ref "salesItemDimension>weightUnit(Simple): unit used for item weight": sales.salesitem_dimension.weight_unit_id > sales.unit_measurement.id
Ref "salesItemPrice>currency(Simple): currency used by the price row": sales.salesitem_price.currency_code > sales.currency.code
Ref "salesItemPrice>salesItem(Simple): price row belongs to a catalog item": sales.salesitem_price.sales_item_id > sales.salesitem.id
